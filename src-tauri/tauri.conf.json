{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "base_station",
  "version": "0.1.0",
  "identifier": "com.basestation.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "base_station",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri:",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost http://localhost:5000 http://localhost:5001 http://localhost:5002",
        "media-src": "'self' http://localhost:5000 http://localhost:5001 http://localhost:5002",
        "connect-src": "'self' http://localhost:* ws://localhost:* https://api.ipify.org",
        "asset": "https://asset.localhost"
      },
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "models/*"
      ],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
